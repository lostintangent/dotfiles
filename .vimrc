" General
set nocompatible
set encoding=utf-8
set history=1000

" UI
set number
set ruler
set showcmd
set showmatch
set wildmenu

" Indentation
set tabstop=2
set shiftwidth=2
set expandtab
set smartindent

" Search
set incsearch
set hlsearch
set ignorecase
set smartcase

" Files
set noswapfile
set nobackup
set autoread
