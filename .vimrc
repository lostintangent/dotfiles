" General settings
set nocompatible
set encoding=utf-8

" UI
set number
set ruler
set showcmd
set showmatch
set wildmenu
set laststatus=2

" Indentation
set tabstop=2
set shiftwidth=2
set expandtab
set smartindent
set autoindent

" Search
set incsearch
set hlsearch
set ignorecase
set smartcase

" Files
set noswapfile
set nobackup
set autoread

" Syntax highlighting
syntax enable
filetype plugin indent on
